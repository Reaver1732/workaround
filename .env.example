# Copy this file to .env and fill in real values.
# .env is gitignored. This file is committed. Never put a real value here.

# PostgreSQL connection string.
# On Railway, use the public TCP proxy URL for local development. The plain
# DATABASE_URL uses a .railway.internal hostname that only resolves inside
# Railway's network and will hang from a laptop.
DATABASE_URL="postgresql://user:password@host:port/database"

# Port for the Express server. Railway sets this automatically in production.
PORT=3000
